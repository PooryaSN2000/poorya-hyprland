{
    "name": "desktop-widget",
    "layer": "bottom",
    "position": "left",
    "width": 300,
    "margin-left": 40,
    "margin-top": 70,
    "exclusive": false,
    "passthrough": true,

    "modules-left": [
        "clock#time",
        "clock#date",
        "custom/sep",
        "cpu",
        "memory",
        "disk",
        "network",
        "battery",
        "custom/uptime"
    ],

    "clock#time": {
        "interval": 1,
        "format": " {:%H:%M:%S}",
        "tooltip": false
    },

    "clock#date": {
        "interval": 60,
        "format": "󰸗 {:%A, %d %b %Y}",
        "tooltip": false
    },

    "custom/sep": {
        "format": "────────────────────────",
        "tooltip": false
    },

    "cpu": {
        "interval": 2,
        "format": "󰍛 CPU    {usage:2d}%",
        "tooltip": false
    },

    "memory": {
        "interval": 2,
        "format": "󰘚 RAM    {percentage:2d}%  ({used:0.1f}GiB)",
        "tooltip": false
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "󰋊 DISK   {percentage_used:2d}%  ({free} free)",
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format-wifi": "󰤨 NET    󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
        "format-ethernet": "󰈀 NET    󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
        "format-disconnected": "󰤭 NET    Offline",
        "tooltip": false
    },

    "battery": {
        "interval": 5,
        "format": "{icon} BAT    {capacity}%",
        "format-charging": "󰂄 BAT    {capacity}% (+{time})",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip": false
    },

    "custom/uptime": {
        "interval": 60,
        "exec": "uptime -p | sed 's/up //'",
        "format": "󰔛 UP     {}",
        "tooltip": false
    }
}
