{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "control-center-width": 430,
  "control-center-height": 780,
  "notification-window-width": 400,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 80,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠",
      "device": "nvidia_wmi_ec_backlight",
      "min": 5
    },
    "notifications": {
      "vexpand": true
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰤨  Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on",
          "update-command": "nmcli radio wifi | grep -q enabled && echo true || echo false"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "active": false,
          "command": "rfkill list bluetooth | grep -q yes && rfkill unblock bluetooth || rfkill block bluetooth",
          "update-command": "rfkill list bluetooth | grep -q yes && echo false || echo true"
        },
        {
          "label": "󰍹  Night Light",
          "type": "toggle",
          "active": false,
          "command": "/home/pooryasn/.config/hypr/scripts/nightlight.sh",
          "update-command": "hyprctl getoption decoration:screen_shader -j | grep -q nightlight.frag && echo true || echo false"
        },
        {
          "label": "󰋋  Audio Output",
          "type": "normal",
          "command": "swaync-client -cp; /home/pooryasn/.config/hypr/scripts/audioswitcher.py"
        },
        {
          "label": "󰓃  Audio Mixer",
          "type": "normal",
          "command": "swaync-client -cp; pavucontrol"
        },
        {
          "label": "󰂯  Bluetooth Devices",
          "type": "normal",
          "command": "swaync-client -cp; blueman-manager"
        },
        {
          "label": "󰤨  Wi-Fi Networks",
          "type": "normal",
          "command": "swaync-client -cp; /home/pooryasn/.config/hypr/scripts/wifimenu.py"
        },
        {
          "label": "󰄄  Screenshot",
          "type": "normal",
          "command": "swaync-client -cp; grim -g \"$(slurp)\" - | wl-copy && notify-send -a \"Screenshot\" \"Area copied to clipboard\""
        },
        {
          "label": "󰌾  Lock Screen",
          "type": "normal",
          "command": "swaync-client -cp; hyprlock"
        },
        {
          "label": "󰐥  Power Menu",
          "type": "normal",
          "command": "swaync-client -cp; /home/pooryasn/.config/hypr/scripts/powermenu.sh"
        }
      ]
    }
  }
}
